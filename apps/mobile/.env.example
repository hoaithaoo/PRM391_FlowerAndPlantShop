# Cấu hình Supabase cho app mobile (khách hàng).
# Copy file này thành `.env` rồi điền giá trị thật; `.env` không được commit.
# Lấy ở Supabase Dashboard > Project Settings > API.
# Chạy app: flutter run --dart-define-from-file=.env
# Để trống cả hai thì app chạy dữ liệu giả (MockAuthRepository, OTP demo 123456).
#
# CHỈ dùng publishable key. Không đặt secret/service_role key vào app.

# Ví dụ: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Ví dụ: sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=

# URL backend Express (không có /api/v1 ở cuối). Để trống thì app dùng
# MockProductRepository. Android emulator gọi máy host qua 10.0.2.2.
# Ví dụ: http://10.0.2.2:4000
API_BASE_URL=

# URL backend Express (không có /api/v1 ở cuối). Để trống thì app dùng
# MockProductRepository. Android emulator gọi máy host qua 10.0.2.2.
# Ví dụ: http://10.0.2.2:4000
API_BASE_URL=
