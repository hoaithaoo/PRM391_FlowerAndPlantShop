# Backend server
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL
# Get these values from Supabase Dashboard -> Connect.
# Keep the real password in apps/backend/.env (never commit it).
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Supabase Auth
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# For projects still using the legacy anon key, use this instead:
# SUPABASE_ANON_KEY="replace_me"

# Optional integrations
SEPAY_WEBHOOK_SECRET="replace_when_enabled"
CORS_ORIGIN="http://localhost:3000"
